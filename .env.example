DATABASE_URL=postgresql://docs_qa:docs_qa@localhost:5432/docs_qa
# comma-separated files/folders that POST /ingest and `python -m docs_qa.ingest` read
DOCS_PATHS=sample_docs,README.md

# fastembed (default, local ONNX), hash (offline lexical baseline) or openai
EMBEDDER=fastembed
FASTEMBED_CACHE_DIR=.models
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small

# extractive (default, no LLM), anthropic or openai
LLM_PROVIDER=extractive
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_CHAT_MODEL=gpt-4o-mini
